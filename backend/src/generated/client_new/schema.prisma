datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client_new"
}

enum Role {
  ADMIN
  TEACHER
}

model User {
  id        Int                  @id @default(autoincrement())
  username  String               @unique
  password  String // Hashed password
  name      String
  role      Role                 @default(TEACHER)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  records   DisciplinaryRecord[]
}

model Student {
  studentNumber  String               @id // e.g. "K011QCEA018" - Primary Key (No. Pelajar)
  icNumber       String               @unique // NRIC format (e.g. 050102091234)
  name           String
  email          String?
  studentPhone   String?
  kursusId       Int
  kursus         Kursus               @relation(fields: [kursusId], references: [id])
  cohort         Int // Year of entry, e.g. 2026
  programType    String // "SVM" or "DVM"
  semester       Int // 1 to 9 (SVM: 1-4, DVM: 5-9)
  status         String               @default("ACTIVE") // "ACTIVE", "SUSPENDED", "GRADUATED", "WITHDRAWN"
  parentName     String
  parentPhone    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  records        DisciplinaryRecord[]
  warningLetters WarningLetter[]
}

model Kursus {
  id       Int       @id @default(autoincrement())
  code     String    @unique // e.g. "CMB", "CBG", "CMC"
  name     String // e.g. "Teknologi Kimpalan", "Kesetiausahaan Pentadbiran"
  students Student[]
}

model OffenceType {
  id          Int                  @id @default(autoincrement())
  code        String               @unique // e.g. A01, B03
  name        String // e.g. Truancy, Smoking
  category    String // e.g. Major, Medium, Minor
  description String?
  records     DisciplinaryRecord[]
}

model DisciplinaryRecord {
  id              Int            @id @default(autoincrement())
  studentId       String // References Student.studentNumber (No. Pelajar)
  student         Student        @relation(fields: [studentId], references: [studentNumber], onDelete: Cascade)
  offenceTypeId   Int
  offenceType     OffenceType    @relation(fields: [offenceTypeId], references: [id])
  teacherId       Int
  teacher         User           @relation(fields: [teacherId], references: [id])
  date            DateTime       @default(now())
  description     String         @db.Text
  createdAt       DateTime       @default(now())
  warningLetterId Int?
  warningLetter   WarningLetter? @relation(fields: [warningLetterId], references: [id], onDelete: SetNull)
}

model WarningLetter {
  id          Int                  @id @default(autoincrement())
  studentId   String // References Student.studentNumber (No. Pelajar)
  student     Student              @relation(fields: [studentId], references: [studentNumber], onDelete: Cascade)
  warningTier Int // 1 = Amaran Pertama, 2 = Amaran Kedua, 3 = Amaran Terakhir / Gantung
  issuedDate  DateTime             @default(now())
  status      String // "PENDING" or "ISSUED"
  month       String // Format "YYYY-MM" (e.g. "2026-07") for monthly grouping
  records     DisciplinaryRecord[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}
